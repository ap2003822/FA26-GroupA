<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="AllianceMobileApp.MainPage"
             x:Name="ItemsPage">

    <ContentPage.Behaviors>
        <mct:EventToCommandBehavior Command="{Binding GetItemsCommand}" BindingContext="{Binding Path=BindingContext, Source={x:Reference ItemsPage}, x:Datatype=ContentPage}" EventName ="Appearing"/>
    </ContentPage.Behaviors>

    <VerticalStackLayout>
        <HorizontalStackLayout>
            <Label Text="Serial #"/>
            <Label Text="Name"/>
            <Label Text="Amount"/>
        </HorizontalStackLayout>
        <Button Text="Items Test" Command="{Binding GetItemsCommand}"/>
        <CollectionView ItemsSource="{Binding listItems}">
            <CollectionView.EmptyView>
            <Label Text="No Items found." HorizontalOptions="Center" VerticalOptions="Center"/>
        </CollectionView.EmptyView>
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Grid ColumnDefinitions="*,Auto" Padding="12,8">
                    <HorizontalStackLayout>
                            <Label Text="{Binding Item_Serial_Number}"/>
                        <!--Serial-->
                            <Label Text="{Binding Item_Name}"/>
                        <!--Name-->
                            <Label Text="{Binding Item_Unit_Amount}"/>
                        <!--Amount-->
                    </HorizontalStackLayout>
                </Grid>
            </DataTemplate>
        </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>
