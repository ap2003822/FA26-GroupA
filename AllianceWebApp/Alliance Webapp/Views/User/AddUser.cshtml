@model Alliance_Webapp.Models.UserModel;
@{ ViewData["Title"] = "Add user"; }

<h1>Add user</h1>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}
@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
}

<div class="row">
    <div class="col-md-5">
        <form asp-action="AddUser" method="post">
            <div class="mb-3">
                <label asp-for="User_Email" class="form-label">Email</label>
                <input asp-for="User_Email" class="form-control" autocomplete="off" />
                <span asp-validation-for="User_Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="User_Password" class="form-label">Password</label>
                <input asp-for="User_Password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="User_Password" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="User_Role" class="form-label">Role</label>
                <input asp-for="User_Role" class="form-control" autocomplete="off" />
                <span asp-validation-for="User_Role" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Create user</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}