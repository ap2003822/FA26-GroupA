
@using Alliance_Webapp.Models;
@model GetAllItemsResponseModel
@{
    ViewData["Title"] = "Home page";
}

<div class="text-center">
    <h2>Items</h2>
    <table class="table table-sm table-striped table-bordered m-2 table-hover">
        <thead>
            <tr>
                <th>Serial #</th>
                <th>Name</th>
                <th>Desc</th>
                <th>Notes</th>
                <th>Amount</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null)
            {
                @if (Model.ItemList != null)
                {
                    @if (Model.ItemList.Count != 0)
                    {

                    
                        @foreach (var item in Model.ItemList)
                        {
                            <tr class="position-relative">
                                <td>@item.Item_Serial_Number</td>
                                <td>@item.Item_Name</td>
                                <td>@item.Item_Desc</td>
                                <td>Item_Notes</td>
                                <td>@item.Item_Unit_Amount</td>
                                <td><a class="stretched-link" asp-controller="Item" asp-action="ItemDetail" asp-route-SId="@item.Item_Serial_Number"></a></td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5">Empty</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5">Uh oh! Something went wrong!</td>
                    </tr>
                }
            }
            else {
                <tr>
                    <td colspan="5">Uh oh! Something went wrong!</td>
                </tr>
            }
        </tbody>
    </table>
</div>
