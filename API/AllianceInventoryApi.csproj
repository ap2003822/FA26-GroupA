<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>2b5e7ca8-29a4-4b1f-8673-716dd6f14361</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="API\**" />
    <Compile Remove="DB\**" />
    <Content Remove="API\**" />
    <Content Remove="DB\**" />
    <EmbeddedResource Remove="API\**" />
    <EmbeddedResource Remove="DB\**" />
    <None Remove="API\**" />
    <None Remove="DB\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageReference Include="Swashbuckle.AspNetCore.Swagger" Version="10.3.0" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="10.3.0" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.0" />
  </ItemGroup>

</Project>
